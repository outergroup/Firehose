APP_ID="org.outershell.Firehose"
APP_NAME="Firehose"
APP_STAGE_NAME="Firehose"
XCODE_PROJECT="Trace.xcodeproj"
XCODE_SCHEME="Trace"
XCODE_PRODUCT_NAME="Trace"
BUNDLE_ARCHIVE_SCRIPT="Scripts/archive_trace_bundle.sh"
BUNDLE_ARCHIVE_STEM="FirehoseContent.bundle"
BACKEND_SOURCE="Backend/main.c"
BACKEND_EXECUTABLE_NAME="FirehoseBackend"
BACKEND_CFLAGS="-std=gnu17 -Os -ffunction-sections -fdata-sections -flto"
BACKEND_LDFLAGS="-lm"
DEFAULT_DEPLOY_SCOPE="system"
ROOT_ONLY="true"
